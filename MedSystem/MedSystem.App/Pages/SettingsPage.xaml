<Page
    x:Class="MedSystem.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="32,24,32,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Настройки" Style="{StaticResource TitleTextBlockStyle}" />

        <Border CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Padding="20,16" Spacing="10">
                <TextBlock Text="Тема оформления" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="ThemeRadios" SelectionChanged="ThemeRadios_SelectionChanged">
                    <x:String>Как в системе</x:String>
                    <x:String>Светлая</x:String>
                    <x:String>Тёмная</x:String>
                </RadioButtons>
            </StackPanel>
        </Border>

        <Border CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Padding="20,16" Spacing="10">
                <TextBlock Text="Корзина" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Удалённые записи можно восстановить до автоматической очистки."
                           TextWrapping="Wrap" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <NumberBox x:Name="TrashRetentionBox" Header="Хранить, дней"
                               Width="150" Minimum="1" Maximum="365"
                               SpinButtonPlacementMode="Inline" />
                    <CheckBox x:Name="NeverDeleteTrashCheckBox" Content="Не удалять автоматически"
                              VerticalAlignment="Bottom" Margin="0,0,0,7"
                              Checked="NeverDeleteTrashCheckBox_Changed"
                              Unchecked="NeverDeleteTrashCheckBox_Changed" />
                </StackPanel>
                <Button Content="Сохранить срок хранения" HorizontalAlignment="Left"
                        Click="SaveTrashRetentionButton_Click" />
            </StackPanel>
        </Border>

        <Border CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Padding="20,16" Spacing="10">
                <TextBlock Text="Резервные копии" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Автоматическая копия создаётся не чаще одного раза в сутки. Хранятся последние 10 копий."
                           TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock x:Name="BackupStatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CreateBackupButton" Content="Создать копию"
                            Click="CreateBackupButton_Click" />
                    <Button x:Name="RestoreBackupButton" Content="Восстановить из копии"
                            Click="RestoreBackupButton_Click" />
                    <ProgressRing x:Name="BackupProgress" Width="20" Height="20"
                                  IsActive="False" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Padding="20,16" Spacing="6">
                <TextBlock Text="О программе" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Медицинская система — учёт обращений, сотрудников, студентов и лекарств медпункта колледжа."
                           TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.6" />
                <TextBlock x:Name="DbPathText" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Page>
