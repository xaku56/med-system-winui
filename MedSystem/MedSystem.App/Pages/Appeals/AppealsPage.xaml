<Page
    x:Class="MedSystem.App.Pages.AppealsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedSystem.App.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Обращения" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <TextBlock x:Name="CountText" Text="" VerticalAlignment="Center" Opacity="0.6" />
                <Button Content="Справочник МКБ" Click="IcdButton_Click" />
                <Button Content="+ Добавить" Style="{StaticResource AccentButtonStyle}"
                        Click="AddButton_Click" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,16,0,12"
                 PlaceholderText="Поиск по номеру или отправителю..."
                 TextChanged="SearchBox_TextChanged" />

        <InfoBar x:Name="ErrorBar" Grid.Row="2" Margin="0,0,0,12"
                 IsOpen="False" Severity="Error" Title="Ошибка загрузки" />

        <Border Grid.Row="3" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="16,12,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="№" FontSize="12" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="Дата" FontSize="12" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="Отправитель" FontSize="12" Opacity="0.6" />
                    <TextBlock Grid.Column="3" Text="Жалобы" FontSize="12" Opacity="0.6" />
                </Grid>
                <Rectangle Grid.Row="1" Height="1" HorizontalAlignment="Stretch"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ListView x:Name="AppealsList" Grid.Row="2" Margin="4,2,4,6" SelectionMode="Single"
                          IsDoubleTapEnabled="True" DoubleTapped="AppealsList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppealRow">
                            <Grid Padding="4,10" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Открыть / Редактировать"
                                                        Tag="{x:Bind Id}" Click="OpenMenuItem_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="В корзину"
                                                        Tag="{x:Bind Id}" Click="DeleteMenuItem_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="2.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Number}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CreatedAt}" Opacity="0.8" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Sender}" Opacity="0.8" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Complaints}" Opacity="0.8"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="LoadingRing" Grid.Row="2" Width="40" Height="40"
                              IsActive="False" Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="PageText" VerticalAlignment="Center" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="PreviousPageButton" Content="Назад"
                        Click="PreviousPageButton_Click" />
                <Button x:Name="NextPageButton" Content="Далее"
                        Click="NextPageButton_Click" />
            </StackPanel>
        </Grid>

    </Grid>
</Page>
