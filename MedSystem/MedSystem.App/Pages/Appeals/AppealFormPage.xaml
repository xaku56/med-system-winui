<Page
    x:Class="MedSystem.App.Pages.AppealFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Text="Новое обращение"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <NumberBox x:Name="NumberBox" Grid.Row="0" Grid.Column="0"
                               Header="Номер обращения" Minimum="1" Maximum="1000000"
                               SpinButtonPlacementMode="Compact" />
                    <TextBox x:Name="CreatedAtBox" Grid.Row="0" Grid.Column="1"
                             Header="Дата обращения" PlaceholderText="дд.мм.гггг" MaxLength="10" />
                    <TextBox x:Name="CreatedTimeBox" Grid.Row="0" Grid.Column="2"
                             Header="Время" PlaceholderText="чч:мм" MaxLength="5" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                        <Grid>
                            <AutoSuggestBox x:Name="SenderBox"
                                            Header="Отправитель"
                                            PlaceholderText="Начните вводить ФИО..."
                                            TextMemberPath="Display"
                                            TextChanged="SenderBox_TextChanged"
                                            SuggestionChosen="SenderBox_SuggestionChosen" />
                            <ProgressRing x:Name="SenderSearchRing" Width="18" Height="18"
                                          Margin="0,22,12,0" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" IsHitTestVisible="False"
                                          IsActive="False" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="StudentLinkText" FontSize="12" Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBox x:Name="BirthDateBox" Grid.Row="2" Grid.Column="0"
                             Header="Дата рождения" PlaceholderText="дд.мм.гггг" MaxLength="10" />
                    <TextBox x:Name="ParentPhoneBox" Grid.Row="2" Grid.Column="1"
                             Header="Телефон родителя" PlaceholderText="+7..." MaxLength="20" />
                    <TextBox x:Name="GroupNameBox" Grid.Row="2" Grid.Column="2"
                             Header="Группа / принадлежность" MaxLength="64" />
                </Grid>

                <TextBox x:Name="ComplaintsBox" Header="Жалобы"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         MaxLength="2000" />

                <TextBlock Text="Объективные данные" Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,8,0,0" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="HeightBox" Grid.Row="0" Grid.Column="0"
                             Header="Рост, см" PlaceholderText="170" MaxLength="3" />
                    <TextBox x:Name="WeightBox" Grid.Row="0" Grid.Column="1"
                             Header="Вес, кг" PlaceholderText="60,5" MaxLength="5" />
                    <TextBox x:Name="TemperatureBox" Grid.Row="0" Grid.Column="2"
                             Header="Температура, °C" PlaceholderText="36,6" MaxLength="4" />

                    <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BloodPressureSystolicBox" Grid.Column="0"
                                 Header="Давление, мм рт. ст." PlaceholderText="120" MaxLength="3" />
                        <Border Grid.Column="1" Height="32" VerticalAlignment="Bottom">
                            <!-- Текст в TextBox стоит чуть выше центра поля: поднимаем «/» к цифрам. -->
                            <TextBlock Text="/" FontSize="18" Opacity="0.7" Margin="0,0,0,6"
                                       TextLineBounds="Tight" VerticalAlignment="Center" />
                        </Border>
                        <TextBox x:Name="BloodPressureDiastolicBox" Grid.Column="2"
                                 Header=" " PlaceholderText="80" MaxLength="3" />
                    </Grid>
                    <TextBox x:Name="PulseBox" Grid.Row="1" Grid.Column="1"
                             Header="Пульс, уд/мин" PlaceholderText="72" MaxLength="3" />
                    <TextBox x:Name="SaturationBox" Grid.Row="1" Grid.Column="2"
                             Header="Сатурация, %" PlaceholderText="98" MaxLength="3" />
                </Grid>

                <Grid>
                    <AutoSuggestBox x:Name="DiagnosisBox"
                                    Header="Диагноз (МКБ)"
                                    PlaceholderText="Начните вводить код или название..."
                                    TextChanged="DiagnosisBox_TextChanged" />
                    <ProgressRing x:Name="DiagnosisSearchRing" Width="18" Height="18"
                                  Margin="0,22,12,0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" IsHitTestVisible="False"
                                  IsActive="False" Visibility="Collapsed" />
                </Grid>

                <TextBox x:Name="ActionsBox" Header="Действия и рекомендации"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         MaxLength="2000" />

                <CheckBox x:Name="AmbulanceCheckBox" Content="Вызов скорой помощи"
                          Padding="8,0,0,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Отмена" MinWidth="110" Click="CancelButton_Click" />
            <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}"
                    MinWidth="130" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Page>
