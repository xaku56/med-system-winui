<Page
    x:Class="MedSystem.App.Pages.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MedSystem.App.Pages">
    <Grid Padding="32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Журнал" Style="{StaticResource TitleTextBlockStyle}" />
        <CalendarDatePicker x:Name="DayPicker" Grid.Row="1" Header="Дата обращений"
                            DateChanged="DayPicker_DateChanged" />
        <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" Title="Не удалось загрузить журнал" />
        <Grid Grid.Row="3">
            <ListView x:Name="JournalList" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="JournalList_ItemClick">
                <ListView.Resources>
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,3" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:JournalRow">
                        <Border Padding="18,14" CornerRadius="{ThemeResource ListViewItemCornerRadius}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Heading}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="{x:Bind Appeal.Sender}" Tag="{x:Bind StudentId}"
                                                 Padding="0" HorizontalAlignment="Left"
                                                 Visibility="{x:Bind LinkVisibility}" Click="Student_Click"
                                                 ToolTipService.ToolTip="Открыть карточку студента" />
                                <TextBlock Text="{x:Bind Appeal.Sender}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Visibility="{x:Bind NameVisibility}" />
                                <TextBlock Text="{x:Bind Complaints}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Diagnosis}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Vitals}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Actions}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Ambulance}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="За выбранный день обращений нет."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <ProgressRing x:Name="LoadingRing" Width="40" Height="40" IsActive="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
