<ContentDialog
    x:Class="MedSystem.App.Pages.StudentImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:repo="using:MedSystem.Data.Repositories"
    Title="Импорт студентов" PrimaryButtonText="Импортировать" CloseButtonText="Отмена"
    PrimaryButtonClick="Import_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="Layout" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <AutoSuggestBox x:Name="GroupBox" Header="Итоговая группа"
                        PlaceholderText="Выберите существующую группу или введите новую"
                        TextChanged="Group_Changed" SuggestionChosen="Group_Chosen"/>
        <TextBlock x:Name="IgnoredText" Grid.Row="1" TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="Students" SelectionMode="Single" SelectionChanged="Row_Changed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="repo:StudentImportRow">
                        <Grid ColumnSpacing="4" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox MinWidth="32" MinHeight="32" VerticalAlignment="Top"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                      Tag="{x:Bind}" IsChecked="{x:Bind Included, Mode=OneWay}" Click="Include_Click"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="0,0,8,2">
                    <TextBox x:Name="LastNameBox" Header="Фамилия" TextChanged="Field_Changed"/>
                    <TextBox x:Name="FirstNameBox" Header="Имя" TextChanged="Field_Changed"/>
                    <TextBox x:Name="MiddleNameBox" Header="Отчество" TextChanged="Field_Changed"/>
                    <TextBox x:Name="AddressBox" Header="Адрес проживания" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Field_Changed"/>
                    <TextBox x:Name="BirthBox" Header="Дата рождения" PlaceholderText="дд.мм.гггг" TextChanged="Field_Changed"/>
                    <TextBox x:Name="OmsBox" Header="Полис ОМС" TextChanged="Field_Changed"/>
                    <TextBox x:Name="ExamBox" Header="Дата медосмотра" PlaceholderText="дд.мм.гггг" TextChanged="Field_Changed"/>
                    <TextBox x:Name="FluoroBox" Header="Дата флюорографии" PlaceholderText="дд.мм.гггг" TextChanged="Field_Changed"/>
                    <TextBox x:Name="HealthBox" Header="Группа здоровья" TextChanged="Field_Changed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Name="Summary" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</ContentDialog>
